<?xml version="1.0" encoding="utf-8"?>
<!-- filename: shanti.xml -->
<!-- XML specification for iBus -->
<component>
    <name>org.freedesktop.IBus.Shanti</name>
    <description>Shanti Keyboard</description>
    <exec>@LIBEXECDIR@/ibus-engine-shanti --ibus</exec>
    <version>@PROJECT_VERSION@</version>
    <author>Shanti Keyboard</author>
    <license>GPL 3</license>
    <homepage>https://github.com/hasanmuammar/OpenBangla-Keyboard-Shanti</homepage>
    <textdomain>shanti-keyboard</textdomain>
    <engines>
        <engine>
            <name>Shanti</name>
            <language>bn</language>
            <license>GPL 3</license>
            <author>Shanti Keyboard</author>
            <icon>@PROJECT_DATADIR@/icons/Shanti-Keyboard.png</icon>
            <layout>default</layout>
            <longname>Shanti Keyboard</longname>
            <description>Shanti Keyboard IME for iBus</description>
            <rank>0</rank>
        </engine>
    </engines>
</component>
