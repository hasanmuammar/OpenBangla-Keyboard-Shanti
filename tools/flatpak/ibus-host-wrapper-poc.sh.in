#!/usr/bin/env bash
# TEMPLATE for disposable integration testing only.
# Configure by replacing @SHANTI_POC_APP_ID@ and install under ~/.local/bin.
# Do not use as a production launcher.
set -euo pipefail

app_id='@SHANTI_POC_APP_ID@'
if [[ "$app_id" == @SHANTI_POC_APP_ID@ || ! "$app_id" =~ ^[A-Za-z0-9_-]+(\.[A-Za-z0-9_-]+)+$ ]]; then
    printf 'shanti-ibus-flatpak-poc: invalid or unsubstituted app ID\n' >&2
    exit 64
fi
command -v flatpak >/dev/null 2>&1 || {
    printf 'shanti-ibus-flatpak-poc: flatpak command not found\n' >&2
    exit 69
}
command -v ibus >/dev/null 2>&1 || {
    printf 'shanti-ibus-flatpak-poc: ibus command not found; cannot discover the host IBus address\n' >&2
    exit 69
}
ibus_address="$(ibus address)" || {
    printf 'shanti-ibus-flatpak-poc: failed to obtain the host IBus address\n' >&2
    exit 69
}
[[ -n "$ibus_address" ]] || {
    printf 'shanti-ibus-flatpak-poc: host IBus returned an empty address\n' >&2
    exit 69
}

exec flatpak run \
    "--env=IBUS_ADDRESS=$ibus_address" \
    --talk-name=org.freedesktop.IBus \
    --own-name=org.freedesktop.IBus.OpenBangla \
    --command=/app/libexec/ibus-engine-openbangla \
    "$app_id" --ibus "$@"
